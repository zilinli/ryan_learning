# Spark AI Tutor — Environment Variables
#
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# Required:
CURSOR_API_KEY=your-cursor-api-key

# Optional:
# CURSOR_MODEL=auto
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_CSE_ID=your-custom-search-engine-id
# SPARK_USE_SYSTEMD=1

# ── 百炼统一语音（STT + TTS，见 docs/subsystems/bailian-stt-tts.md）──
# ALIYUN_DASHSCOPE_API_KEY=sk-xxx
# ALIYUN_DASHSCOPE_REGION=cn-beijing
# ALIYUN_WORKSPACE_ID=your-workspace-id
# ALIYUN_ASR_MODEL=fun-asr-flash-2026-06-15
# ALIYUN_ASR_FALLBACK_MODEL=qwen3-asr-flash
# TEO_CLONE_VOICE_ID=cosyvoice-v3-plus-teochew-xxxx
# HAK_CLONE_VOICE_ID=   # 客家话本周朗读走 FormoSpeech，一般留空
# ALIYUN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

# ── 讯飞方言 ASR：默认关闭（控费）；需要时作 teo/hak 备份 ──
# STT_BACKUP_IFYTEK=0
# IFYTEK_APP_ID=your-appid
# IFYTEK_API_KEY=your-api-key
# IFYTEK_API_SECRET=your-api-secret

# ── 客家话 FormoSpeech TTS（本周朗读主路径）──
# FORMOSPEECH_TTS_URL=http://127.0.0.1:9876
# 预合成：.venv-formospeech/bin/python scripts/formospeech_presynth.py --phrases scripts/formospeech_phrases_hak.json --force

# ── 方言 TTS 磁盘缓存（可选）──
# TTS_CACHE_MAX_BYTES=3221225472
# TTS_CACHE_TTL_MS=172800000

# ── Lyric Studio / Bailian Fun-Music（复用 ALIYUN_DASHSCOPE_API_KEY；需模型广场申请 fun-music-v1 邀测）──
# 文档: https://help.aliyun.com/zh/model-studio/fun-music-api
# FUN_MUSIC_MODEL=fun-music-v1
# FUN_MUSIC_BASE_URL=   # 可选覆盖；默认 Workspace 北京 MaaS 或 dashscope

# ── Lyric Studio / Volcengine GenSong fallback（预付费 GenSongV4 + 后付费 GenSongForTime）──
# 文档: https://www.volcengine.com/docs/84992/2091679
# 可用「访问密钥 AK/SK」或控制台「API Key ID/Secret」填到下面两行：
# VOLC_ACCESS_KEY_ID=
# VOLC_SECRET_ACCESS_KEY=
# VOLC_API_KEY_ID=          # 可选别名，等同 ACCESS_KEY_ID
# VOLC_API_KEY_SECRET=      # 可选别名，等同 SECRET_ACCESS_KEY
# VOLC_MUSIC_REGION=cn-beijing
# VOLC_MUSIC_SERVICE=imagination
# VOLC_MUSIC_BILLING_ORDER=prepaid,postpaid
# VOLC_MUSIC_MODEL=v4.3
