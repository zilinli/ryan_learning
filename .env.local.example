# Spark AI Tutor — Environment Variables
#
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# Required:
CURSOR_API_KEY=your-cursor-api-key

# Optional:
# CURSOR_MODEL=auto
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_CSE_ID=your-custom-search-engine-id
# SPARK_USE_SYSTEMD=1

# ── 方言 STT：讯飞方言识别大模型（潮汕话/客家话优先；失败回退本地 Whisper）──
# 控制台：方言识别大模型 → Websocket 服务接口认证信息
# IFYTEK_APP_ID=your-appid
# IFYTEK_API_KEY=your-api-key
# IFYTEK_API_SECRET=your-api-secret

# ── 方言 TTS（潮汕/客家 **禁止粤语 zh-HK 顶替**）──
# 潮汕：百炼复刻或闽南话 longanmin_v3。客家：FormoSpeech 预合成缓存（或 HAK_CLONE / FORMOSPEECH_TTS_URL）。
# ALIYUN_DASHSCOPE_API_KEY=sk-xxx
# ALIYUN_DASHSCOPE_REGION=cn-beijing
# ALIYUN_WORKSPACE_ID=your-workspace-id
# TEO_CLONE_VOICE_ID=cosyvoice-v3-plus-teochew-xxxx
# HAK_CLONE_VOICE_ID=cosyvoice-v3-plus-hakka-xxxx
# ALIYUN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
# FORMOSPEECH_TTS_URL=http://127.0.0.1:9876
# 预合成：python scripts/formospeech_presynth.py --phrases scripts/formospeech_phrases_hak.json

# ── 方言 TTS 磁盘缓存（可选）──
# TTS_CACHE_MAX_BYTES=3221225472
# TTS_CACHE_TTL_MS=172800000
