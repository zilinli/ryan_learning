[Unit]
Description=Spark STT/TTS Server (Whisper + SenseVoice + edge-tts)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/codes/ryan_learning

# Environment — SenseVoice-first preload avoids dual-model OOM on 4GB hosts
Environment=STT_HOST=127.0.0.1
Environment=STT_PORT=8765
Environment=STT_MODEL=small
Environment=STT_PRELOAD=sensevoice
Environment=SENSEVOICE_THREADS=2
Environment=PYTHONUNBUFFERED=1
Environment=LD_LIBRARY_PATH=/usr/local/lib/python3.9/site-packages/sherpa_onnx/lib

# Free stale listeners, then start
ExecStartPre=/usr/bin/bash -c 'lsof -ti tcp:8765 | xargs -r kill -TERM 2>/dev/null; sleep 1'
ExecStart=/usr/bin/python3 scripts/stt_server.py

# Restart policy — stop OOM crash storms (was Restart=always)
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=4
TimeoutStartSec=600

# Soft cap; leave headroom for Next.js on 4GB box
MemoryMax=2.5G
MemoryHigh=2.2G
CPUQuota=150%
TasksMax=32

# HF cache + logs need write access under /root (no ProtectHome)
NoNewPrivileges=true
ReadWritePaths=/root/codes/ryan_learning
ReadWritePaths=/root/.cache
ReadWritePaths=/tmp
PrivateTmp=false

StandardOutput=append:/root/codes/ryan_learning/logs/stt.log
StandardError=append:/root/codes/ryan_learning/logs/stt.log
SyslogIdentifier=spark-stt

[Install]
WantedBy=multi-user.target
